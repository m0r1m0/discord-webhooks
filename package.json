{
  "name": "discord-webhooks",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "set-secrets": "wrangler secret bulk .dev.vars",
    "deploy": "wrangler deploy --minify --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "tsc"
  },
  "dependencies": {
    "hono": "^4.10.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "@vitest/ui": "^4.0.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "wrangler": "^4.4.0"
  }
}